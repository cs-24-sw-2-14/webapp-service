PUBLIC_REST_API_PROTOCOL=http
# It is set to be the protocol http (HyperText Transfer Protocol) 
PUBLIC_REST_API_HOSTNAME=localhost
# It is set to be the hostname localhost (The computer you are working on) 
PUBLIC_REST_API_PORT=5123
# It is set to be the port 5123 (a port in the computer) 
PUBLIC_SOCKET_API_PROTOCOL=ws
# It is set to be the protocol ws (WebSockets) 
PUBLIC_SOCKET_API_HOSTNAME=localhost
# It is set to be the hostname localhost (The computer you are working on) 
PUBLIC_SOCKET_API_PORT=5123 
# It is set to be the port 5123 (a port in the computer) 
